{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/free-listing-score",
      "destination": "/#optimizer",
      "permanent": true
    },
    {
      "source": "/free-listing-score.html",
      "destination": "/#optimizer",
      "permanent": true
    },
    {
      "source": "/free-marketplace-review",
      "destination": "/#optimizer",
      "permanent": true
    },
    {
      "source": "/free-marketplace-review.html",
      "destination": "/#optimizer",
      "permanent": true
    },
    {
      "source": "/website-reviews",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/website-reviews.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/missed-lead-recovery",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/missed-lead-recovery.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/ai-tools-for-small-business",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/ai-tools-for-small-business.html",
      "destination": "/#services",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-followup",
      "schedule": "0 0 * * *"
    }
  ]
}
